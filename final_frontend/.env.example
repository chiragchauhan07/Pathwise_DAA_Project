# Leave VITE_API_BASE_URL empty to call relative "/api/v1/..." URLs.
# In development Vite proxies /api to the backend, so no CORS setup is required.
# Set it to an absolute URL (e.g. http://127.0.0.1:8000) only when the backend
# allows your frontend origin via CORS (the current backend does not configure CORS).
VITE_API_BASE_URL=

# Where the Vite dev/preview server forwards /api requests (backend default port is 8000).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Request timeout in milliseconds. AI-assisted requests can be slow (backend Gemini timeout defaults to 15s).
VITE_API_TIMEOUT_MS=45000
